{
  "expo": {
    "name": "OptiRide",
    "slug": "optiride",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "optiride",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "extra": {
      "eas": {
        "projectId": "optiride-local"
      },
      "supabaseUrl": "",
      "supabaseAnonKey": ""
    }
  }
}
